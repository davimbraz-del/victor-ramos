{
  "name": "victor-ramos-landing",
  "version": "1.0.0",
  "private": true,
  "description": "Landing page de Victor Ramos — Correspondente bancário Caixa em Recife",
  "scripts": {
    "icons": "node scripts/build-icons.mjs",
